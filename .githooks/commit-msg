#!/usr/bin/env bash
# Enforces a Conventional Commits subject line: type(scope)?: summary
set -euo pipefail
subject=$(head -n1 "$1")
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .{1,72}$'
if ! [[ "$subject" =~ $pattern ]]; then
  echo "commit-msg: subject must follow Conventional Commits, e.g. 'feat(importers): add RaceChrono CSV v3'" >&2
  echo "  got: $subject" >&2
  exit 1
fi

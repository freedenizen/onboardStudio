#!/usr/bin/env bash
# Runs formatting and lint checks on staged Swift files before every commit.
# Compatible with the bash 3.2 that ships with macOS.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
files=()
while IFS= read -r f; do
  [[ -n "$f" ]] && files+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.swift')
[[ ${#files[@]} -eq 0 ]] && exit 0
echo "pre-commit: swift format lint (${#files[@]} files)"
swift format lint --strict "${files[@]}"
if command -v swiftlint >/dev/null; then
  echo "pre-commit: swiftlint"
  swiftlint lint --quiet --strict "${files[@]}"
fi
